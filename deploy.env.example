# Copy to deploy.env (git-ignored) and fill in YOUR Azure/Foundry names.
# None of these are secrets, but they identify your cloud estate.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
NEXROZA_RESOURCE_GROUP=rg-nexroza-calendar-mcp
NEXROZA_FUNCTION_APP=func-api-xxxxxxxxxxxxx
NEXROZA_STORAGE_ACCOUNT=stxxxxxxxxxxxxx
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
FOUNDRY_RESOURCE_GROUP=rg-my-foundry
FOUNDRY_ACCOUNT=my-foundry-resource
FOUNDRY_PROJECT=my-foundry-project
FOUNDRY_AGENT_NAME=Plumbing-Service-Coordinator
LOG_ANALYTICS_WORKSPACE_ID=
